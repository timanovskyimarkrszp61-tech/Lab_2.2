\pard\plain\ql     double eps = 0.0;        \par
\pard\plain\ql     double result = 0.0;     \par
\pard\plain\ql \par
\pard\plain\ql     printf("Laboratory work #2.2 | Numerical Integration | Variant 5\\n");\par
\pard\plain\ql     printf("Student: Timanovskyi Mark Olehovych | Group: RS-zp61\\n\\n");\par
\pard\plain\ql \par
\pard\plain\ql     do\par
\pard\plain\ql     \{\par
\pard\plain\ql         printf("Select numerical integration method:\\n");\par
\pard\plain\ql         printf("  1 - Left rectangles method\\n");\par
\pard\plain\ql         printf("  2 - Right rectangles method\\n");\par
\pard\plain\ql         printf("  3 - Trapezoidal method\\n");\par
\pard\plain\ql         printf("  4 - Simpson's (parabolic) method\\n");\par
\pard\plain\ql         printf("  5 - Compare all 4 methods (fixed N and precision eps)\\n");\par
\pard\plain\ql         printf("Enter method (1-5): ");\par
\pard\plain\ql \par
\pard\plain\ql         if (scanf("%d", &method) != 1)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Input error! Please enter an integer from 1 to 5.\\n\\n");\par
\pard\plain\ql             clear_input_buffer();\par
\pard\plain\ql             method = 0;\par
\pard\plain\ql             continue;\par
\pard\plain\ql         \}\par
\pard\plain\ql         clear_input_buffer();\par
\pard\plain\ql \par
\pard\plain\ql         if (method < 1 || method > 5)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Invalid choice! Only values 1..5 are allowed.\\n\\n");\par
\pard\plain\ql         \}\par
\pard\plain\ql     \} while (method < 1 || method > 5);\par
\pard\plain\ql \par
\pard\plain\ql     while (1)\par
\pard\plain\ql     \{\par
\pard\plain\ql         printf("\\nEnter lower integration limit a: ");\par
\pard\plain\ql         if (scanf("%lf", &a) != 1)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Input error! Enter a valid floating-point number.\\n");\par
\pard\plain\ql             clear_input_buffer();\par
\pard\plain\ql             continue;\par
\pard\plain\ql         \}\par
\pard\plain\ql         clear_input_buffer();\par
\pard\plain\ql \par
\pard\plain\ql         printf("Enter upper integration limit b (b > a): ");\par
\pard\plain\ql         if (scanf("%lf", &b) != 1)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Input error! Enter a valid floating-point number.\\n");\par
\pard\plain\ql             clear_input_buffer();\par
\pard\plain\ql             continue;\par
\pard\plain\ql         \}\par
\pard\plain\ql         clear_input_buffer();\par
\pard\plain\ql \par
\pard\plain\ql         if (b <= a)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Validation error! Upper limit b must be greater than a.\\n");\par
\pard\plain\ql         \}\par
\pard\plain\ql         else\par
\pard\plain\ql         \{\par
\pard\plain\ql             break;\par
\pard\plain\ql         \}\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     while (1)\par
\pard\plain\ql     \{\par
\pard\plain\ql         printf("Enter number of subintervals N (N >= 2): ");\par
\pard\plain\ql         if (scanf("%u", &n) != 1)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Input error! Enter a positive integer.\\n");\par
\pard\plain\ql             clear_input_buffer();\par
\pard\plain\ql             continue;\par
\pard\plain\ql         \}\par
\pard\plain\ql         clear_input_buffer();\par
\pard\plain\ql \par
\pard\plain\ql         if (n < 2)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Validation error! N must be at least 2.\\n");\par
\pard\plain\ql         \}\par
\pard\plain\ql         else\par
\pard\plain\ql         \{\par
\pard\plain\ql             break;\par
\pard\plain\ql         \}\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     if ((method == 4 || method == 5) && (n % 2 != 0))\par
\pard\plain\ql     \{\par
\pard\plain\ql         n++;\par
\pard\plain\ql         printf("Note: Simpson's method requires even N. Adjusted N = %u.\\n", n);\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     while (1)\par
\pard\plain\ql     \{\par
\pard\plain\ql         printf("Enter required precision eps (e.g. 0.0001): ");\par
\pard\plain\ql         if (scanf("%lf", &eps) != 1)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Input error! Enter a valid positive number.\\n");\par
\pard\plain\ql             clear_input_buffer();\par
\pard\plain\ql             continue;\par
\pard\plain\ql         \}\par
\pard\plain\ql         clear_input_buffer();\par
\pard\plain\ql \par
\pard\plain\ql         if (eps <= 0.0)\par
\pard\plain\ql         \{\par
\pard\plain\ql             printf("Validation error! Precision eps must be strictly positive.\\n");\par
\pard\plain\ql         \}\par
\pard\plain\ql         else\par
\pard\plain\ql         \{\par
\pard\plain\ql             break;\par
\pard\plain\ql         \}\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     printf("\\nIntegration interval: [%.4lf; %.4lf], N = %u, h = %.6lf, eps = %.6lf\\n\\n",\par
\pard\plain\ql            a, b, n, (b - a) / (double)n, eps);\par
\pard\plain\ql \par
\pard\plain\ql     if (method >= 1 && method <= 4)\par
\pard\plain\ql     \{\par
\pard\plain\ql         unsigned int n_eps = 0;\par
\pard\plain\ql         double result_eps = 0.0;\par
\pard\plain\ql \par
\pard\plain\ql         if (method == 1)\par
\pard\plain\ql         \{\par
\pard\plain\ql             result = left_rectangles(a, b, n);\par
\pard\plain\ql             printf("Method: Left rectangles\\n");\par
\pard\plain\ql         \}\par
\pard\plain\ql         else if (method == 2)\par
\pard\plain\ql         \{\par
\pard\plain\ql             result = right_rectangles(a, b, n);\par
\pard\plain\ql             printf("Method: Right rectangles\\n");\par
\pard\plain\ql         \}\par
\pard\plain\ql         else if (method == 3)\par
\pard\plain\ql         \{\par
\pard\plain\ql             result = trapezoidal(a, b, n);\par
\pard\plain\ql             printf("Method: Trapezoidal\\n");\par
\pard\plain\ql         \}\par
\pard\plain\ql         else\par
\pard\plain\ql         \{\par
\pard\plain\ql             result = simpson(a, b, n);\par
\pard\plain\ql             printf("Method: Simpson's (parabolic)\\n");\par
\pard\plain\ql         \}\par
\pard\plain\ql \par
\pard\plain\ql         result_eps = integrate_with_precision(method, a, b, eps, &n_eps);\par
\pard\plain\ql \par
\pard\plain\ql         printf("Integral value (for fixed N = %u) : %.8lf\\n", n, result);\par
\pard\plain\ql         printf("Integral value (with eps = %.6lf): %.8lf (reached at N = %u)\\n",\par
\pard\plain\ql                eps, result_eps, n_eps);\par
\pard\plain\ql     \}\par
\pard\plain\ql     else\par
\pard\plain\ql     \{\par
\pard\plain\ql         const char *names[4] = \{\par
\pard\plain\ql             "Left rectangles",\par
\pard\plain\ql             "Right rectangles",\par
\pard\plain\ql             "Trapezoidal",\par
\pard\plain\ql             "Simpson's"\par
\pard\plain\ql         \};\par
\pard\plain\ql         double fixed_vals[4] = \{\par
\pard\plain\ql             left_rectangles(a, b, n),\par
\pard\plain\ql             right_rectangles(a, b, n),\par
\pard\plain\ql             trapezoidal(a, b, n),\par
\pard\plain\ql             simpson(a, b, n)\par
\pard\plain\ql         \};\par
\pard\plain\ql \par
\pard\plain\ql         printf("+---------------------+--------------------+--------------------+------------+\\n");\par
\pard\plain\ql         printf("| Method              | I (fixed N=%-5u) | I (precision eps)  | Final N    |\\n", n);\par
\pard\plain\ql         printf("+---------------------+--------------------+--------------------+------------+\\n");\par
\pard\plain\ql \par
\pard\plain\ql         for (int m = 1; m <= 4; m++)\par
\pard\plain\ql         \{\par
\pard\plain\ql             unsigned int n_eps = 0;\par
\pard\plain\ql             double val_eps = integrate_with_precision(m, a, b, eps, &n_eps);\par
\pard\plain\ql             printf("| %-19s | %18.8lf | %18.8lf | %10u |\\n",\par
\pard\plain\ql                    names[m - 1], fixed_vals[m - 1], val_eps, n_eps);\par
\pard\plain\ql             printf("+---------------------+--------------------+--------------------+------------+\\n");\par
\pard\plain\ql         \}\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     return 0; \par
\pard\plain\ql \}\par
\pard\plain\ql \par
\pard\plain\ql double f(double x)\par
\pard\plain\ql \{\par
\pard\plain\ql     return x / sqrt(x * x + 16.0);\par
\pard\plain\ql \}\par
\pard\plain\ql \par
\pard\plain\ql double left_rectangles(double a, double b, unsigned int n)\par
\pard\plain\ql \{\par
\pard\plain\ql     double h = (b - a) / (double)n;\par
\pard\plain\ql     double sum = 0.0;\par
\pard\plain\ql \par
\pard\plain\ql     for (unsigned int i = 0; i < n; i++)\par
\pard\plain\ql     \{\par
\pard\plain\ql         sum += f(a + (double)i * h);\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     return sum * h;\par
\pard\plain\ql \}\par
\pard\plain\ql \par
\pard\plain\ql double right_rectangles(double a, double b, unsigned int n)\par
\pard\plain\ql \{\par
\pard\plain\ql     double h = (b - a) / (double)n;\par
\pard\plain\ql     double sum = 0.0;\par
\pard\plain\ql \par
\pard\plain\ql     for (unsigned int i = 1; i <= n; i++)\par
\pard\plain\ql     \{\par
\pard\plain\ql         sum += f(a + (double)i * h);\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     return sum * h;\par
\pard\plain\ql \}\par
\pard\plain\ql \par
\pard\plain\ql double trapezoidal(double a, double b, unsigned int n)\par
\pard\plain\ql \{\par
\pard\plain\ql     double h = (b - a) / (double)n;\par
\pard\plain\ql     double sum = 0.5 * (f(a) + f(b));\par
\pard\plain\ql \par
\pard\plain\ql     for (unsigned int i = 1; i < n; i++)\par
\pard\plain\ql     \{\par
\pard\plain\ql         sum += f(a + (double)i * h);\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     return sum * h;\par
\pard\plain\ql \}\par
\pard\plain\ql \par
\pard\plain\ql double simpson(double a, double b, unsigned int n)\par
\pard\plain\ql \{\par
\pard\plain\ql     if (n % 2 != 0)\par
\pard\plain\ql     \{\par
\pard\plain\ql         n++;\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     double h = (b - a) / (double)n;\par
\pard\plain\ql     double sum = f(a) + f(b);\par
\pard\plain\ql \par
\pard\plain\ql     for (unsigned int i = 1; i < n; i++)\par
\pard\plain\ql     \{\par
\pard\plain\ql         double x = a + (double)i * h;\par
\pard\plain\ql         if (i % 2 == 0)\par
\pard\plain\ql         \{\par
\pard\plain\ql             sum += 2.0 * f(x);\par
\pard\plain\ql         \}\par
\pard\plain\ql         else\par
\pard\plain\ql         \{\par
\pard\plain\ql             sum += 4.0 * f(x);\par
\pard\plain\ql         \}\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     return sum * (h / 3.0);\par
\pard\plain\ql \}\par
\pard\plain\ql \par
\pard\plain\ql double integrate_with_precision(int method, double a, double b, double eps, unsigned int *final_n)\par
\pard\plain\ql \{\par
\pard\plain\ql     unsigned int curr_n = 2;\par
\pard\plain\ql     double i_prev = 0.0;\par
\pard\plain\ql     double i_curr = 0.0;\par
\pard\plain\ql     double runge_coeff = 1.0; \par
\pard\plain\ql \par
\pard\plain\ql     if (method == 1)\par
\pard\plain\ql     \{\par
\pard\plain\ql         i_prev = left_rectangles(a, b, curr_n);\par
\pard\plain\ql         runge_coeff = 1.0; \par
\pard\plain\ql     \}\par
\pard\plain\ql     else if (method == 2)\par
\pard\plain\ql     \{\par
\pard\plain\ql         i_prev = right_rectangles(a, b, curr_n);\par
\pard\plain\ql         runge_coeff = 1.0; \par
\pard\plain\ql     \}\par
\pard\plain\ql     else if (method == 3)\par
\pard\plain\ql     \{\par
\pard\plain\ql         i_prev = trapezoidal(a, b, curr_n);\par
\pard\plain\ql         runge_coeff = 3.0;\par
\pard\plain\ql     \}\par
\pard\plain\ql     else\par
\pard\plain\ql     \{\par
\pard\plain\ql         i_prev = simpson(a, b, curr_n);\par
\pard\plain\ql         runge_coeff = 15.0; \par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     while (curr_n < MAX_INTERVALS)\par
\pard\plain\ql     \{\par
\pard\plain\ql         curr_n *= 2;\par
\pard\plain\ql \par
\pard\plain\ql         if (method == 1)\par
\pard\plain\ql         \{\par
\pard\plain\ql             i_curr = left_rectangles(a, b, curr_n);\par
\pard\plain\ql         \}\par
\pard\plain\ql         else if (method == 2)\par
\pard\plain\ql         \{\par
\pard\plain\ql             i_curr = right_rectangles(a, b, curr_n);\par
\pard\plain\ql         \}\par
\pard\plain\ql         else if (method == 3)\par
\pard\plain\ql         \{\par
\pard\plain\ql             i_curr = trapezoidal(a, b, curr_n);\par
\pard\plain\ql         \}\par
\pard\plain\ql         else\par
\pard\plain\ql         \{\par
\pard\plain\ql             i_curr = simpson(a, b, curr_n);\par
\pard\plain\ql         \}\par
\pard\plain\ql \par
\pard\plain\ql         if (fabs(i_curr - i_prev) / runge_coeff <= eps)\par
\pard\plain\ql         \{\par
\pard\plain\ql             break;\par
\pard\plain\ql         \}\par
\pard\plain\ql \par
\pard\plain\ql         i_prev = i_curr;\par
\pard\plain\ql     \}\par
\pard\plain\ql \par
\pard\plain\ql     *final_n = curr_n;\par
\pard\plain\ql     return i_curr;\par
\pard\plain\ql \}\par
\pard\plain\ql \par
